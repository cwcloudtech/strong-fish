POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_DB=strongfish
POSTGRES_USER=strongfish
POSTGRES_PASSWORD=strongfish
POSTGRES_POOL_SIZE=5
JWT_SECRET=changeme
MAX_WORKERS=5
PORT=8080
SF_CORS_ENABLED=true
SF_CORS_ALLOWED_ORIGINS=*
SF_API_URL=http://localhost:8080
SF_UI_URL=http://localhost:3000
# Max decoded size (bytes) of a single base64 image: avatars, club logos and
# post pictures (stored as b64 inside the JSONB payload).
SF_MAX_IMAGE_SIZE=2097152
# Max decoded size (bytes) of an uploaded program spreadsheet.
SF_MAX_UPLOAD_SIZE=10485760
# Max size (bytes) of one uploaded video. Unlike images, videos never touch
# this app's storage - they go to the member's own bucket (see the storage
# section of the README) - so this bounds what the API will relay, not what a
# row can hold.
SF_MAX_VIDEO_SIZE=20971520
# admin: a superadmin flips a new account to confirmed by hand.
# email:  the user follows the confirmation link emailed to them.
SF_ACTIVATION_MODE=email
SF_CONFIRMATION_EMAIL_EXPIRATION=24
SF_MAIL_FROM=noreply@strong-fish.com
# Weight increment (kg) computed loads are rounded to for the "rounded" column
# shown next to the exact load - 2.5 is one small plate per side on a 20kg bar.
SF_PLATE_INCREMENT=2.5
# Where the Android build is published. {version} is replaced with the running
# app version, and a path is resolved against SF_UI_URL - the same URL is
# encoded into the QR code offered on desktop, and a relative one would be
# unscannable. Leave blank to hide the download entry entirely.
SF_MOBILE_URL_PATTERN=/strong-fish-v{version}.apk
# Shown on the signed-out screens, under the photo credit.
SF_GIT_REPO_URL=https://gitlab.cwcloud.tech/oss/strong-fish
# Where the About link points. The page lives in the wiki (sf-wiki), so the app
# links out rather than shipping a second copy of the text.
SF_ABOUT_URL=https://doc.strong-fish.com/docs/about
# The wiki's root, linked from the sidebar.
SF_DOC_URL=https://doc.strong-fish.com
# Observability. One collector receives traces, logs and metrics. Leave the
# endpoint blank to disable export - logs still go to stdout/stderr and
# /v1/metrics still serves, so a deployment with no collector is still fully
# observable locally. SF_OTEL_PROTO is otlp/grpc (the default) or otlp/http.
SF_OTEL_ENDPOINT=
SF_OTEL_PROTO=otlp/grpc
SF_OIDC_GOOGLE_CLIENT_ID=
SF_OIDC_GOOGLE_CLIENT_SECRET=
SF_OIDC_GITHUB_CLIENT_ID=
SF_OIDC_GITHUB_CLIENT_SECRET=
SF_OIDC_KEYCLOAK_BASE_URL=
SF_OIDC_KEYCLOAK_CLIENT_ID=
SF_OIDC_KEYCLOAK_CLIENT_SECRET=
SF_OIDC_KEYCLOAK_GROUPS=
# CWCloud email API (same integration as cwclock): CWCLOUD_API_KEY is the
# X-Auth-Token every POST {CWCLOUD_API_URL}/v1/email is sent with. Leaving it
# blank disables outgoing email (logged and skipped, never fatal).
CWCLOUD_API_URL=https://api.cwcloud.tech
CWCLOUD_API_KEY=
# The uuid of the CWCloud contact form submissions are posted to
# (POST {CWCLOUD_API_URL}/v1/contactreq). Unlike the email API this needs no
# key - the form id is what scopes the submission. Leave it blank to disable
# the contact form: the endpoint then answers 405 and the frontend hides the
# link rather than offering a page that cannot work.
CWCLOUD_CONTACT_FORM_ID=
