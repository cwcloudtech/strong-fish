POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_DB=strongfish
POSTGRES_USER=strongfish
POSTGRES_PASSWORD=strongfish
POSTGRES_POOL_SIZE=5
JWT_SECRET=changeme
MAX_WORKERS=5
PORT=8080
SF_CORS_ENABLED=true
SF_CORS_ALLOWED_ORIGINS=*
SF_API_URL=http://localhost:8080
SF_UI_URL=http://localhost:3000
# Max decoded size (bytes) of a single base64 image: avatars, club logos and
# post pictures (stored as b64 inside the JSONB payload).
SF_MAX_IMAGE_SIZE=2097152
# Max decoded size (bytes) of an uploaded program spreadsheet.
SF_MAX_UPLOAD_SIZE=10485760
# admin: a superadmin flips a new account to confirmed by hand.
# email:  the user follows the confirmation link emailed to them.
SF_ACTIVATION_MODE=email
SF_CONFIRMATION_EMAIL_EXPIRATION=24
SF_MAIL_FROM=noreply@cwcloud.tech
# Weight increment (kg) computed loads are rounded to for the "rounded" column
# shown next to the exact load - 2.5 is one small plate per side on a 20kg bar.
SF_PLATE_INCREMENT=2.5
SF_OIDC_GOOGLE_CLIENT_ID=
SF_OIDC_GOOGLE_CLIENT_SECRET=
SF_OIDC_GITHUB_CLIENT_ID=
SF_OIDC_GITHUB_CLIENT_SECRET=
SF_OIDC_KEYCLOAK_BASE_URL=
SF_OIDC_KEYCLOAK_CLIENT_ID=
SF_OIDC_KEYCLOAK_CLIENT_SECRET=
SF_OIDC_KEYCLOAK_GROUPS=
# CWCloud email API (same integration as cwclock): CWCLOUD_API_KEY is the
# X-Auth-Token every POST {CWCLOUD_API_URL}/v1/email is sent with. Leaving it
# blank disables outgoing email (logged and skipped, never fatal).
CWCLOUD_API_URL=https://api.cwcloud.tech
CWCLOUD_API_KEY=
