# Everything ci/app/deliver-ios.sh needs. Copy to .env.ios and fill it in.
#
#   cp .env.ios.example .env.ios
#
# Nothing else belongs here. The signing certificate makes itself on the first
# run and stays as ios.p12; everything else the build needs is in VERSION, in
# the Xcode project, or a default in the script.
#
# .env.ios is gitignored.

# Your Apple Developer team, from developer.apple.com/account (Membership).
IOS_TEAM_ID=

# --- only for ./ci/app/deliver-ios.sh --upload ------------------------------
#
# An App Store Connect API key, from App Store Connect > Users and Access >
# Integrations > App Store Connect API.
#
# Apple lets you download the .p8 exactly once. Put it in the repository root
# under the name Apple gave it - AuthKey_<key id>.p8 - and the script finds it.
# It is gitignored, and stays there for every run after this one.
IOS_API_KEY_ID=
IOS_API_ISSUER_ID=
