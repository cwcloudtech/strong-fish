REACT_APP_SEO_TITLE="StrongFish - Powerlifting social network & app"
REACT_APP_SEO_DESCRIPTION="StrongFish is the powerlifting social network and app: share your training in a feed, follow lifters and clubs, run RPE-based programs with per-athlete 1RM load calculation, and track velocity-based training."
REACT_APP_SEO_KEYWORDS="powerlifting social network,powerlifting network,powerlifting app,strongfish,strong-fish,powerlifting,RPE,1RM,squat,bench,deadlift,VBT,velocity based training,powerlifting community,training feed,coaching"
REACT_APP_UIURL="${SF_UI_URL}"
REACT_APP_APIURL="${SF_API_URL}"
REACT_APP_PAGE_SIZE=20
REACT_APP_GIT_REPO_URL="${SF_GIT_REPO_URL}"
