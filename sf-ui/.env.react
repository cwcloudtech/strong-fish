REACT_APP_SEO_TITLE="strong-fish - Powerlifting app"
REACT_APP_SEO_DESCRIPTION="strong-fish is a powerlifting app: RPE-based programs, per-athlete 1RM load calculation, clubs and a training feed."
REACT_APP_SEO_KEYWORDS="strong-fish,powerlifting,RPE,1RM,squat,bench,deadlift,coaching"
REACT_APP_UIURL="${SF_UI_URL}"
REACT_APP_APIURL="${SF_API_URL}"
REACT_APP_PAGE_SIZE=20
REACT_APP_MOBILE_URL_PATTERN="/strong-fish-v{version}.apk"
